{
  "name": "cc-switch-lite",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "更简洁的 LLM 供应商切换器：根据 Base URL 自动发现模型，一键应用到 Claude Code / Codex CLI",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.switchlite.app",
    "productName": "SwitchLite",
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "server/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "SwitchLite"
    },
    "portable": {
      "artifactName": "SwitchLite-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
